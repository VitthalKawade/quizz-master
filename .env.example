# ==========================================
# ⚡ QuizzMaster Pro - Environment Variables
# ==========================================

# Port for Node.js Express Server (default: 3000)
PORT=3000

# Secret key for signing JWT tokens
JWT_SECRET=quizzmaster_jwt_secret_key_2026_super_secure

# Environment ('development' | 'production')
NODE_ENV=development

# ==========================================
# 🍃 MongoDB Atlas Connection String
# ==========================================
# Paste your MongoDB Atlas connection string below:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/quizzmaster?retryWrites=true&w=majority
# (Leave empty to use built-in local JSON file storage)
MONGODB_URI=
